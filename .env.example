# ===== sb.sb 论坛 RSS 订阅推送 · 配置模板 =====
# 复制为 .env 并填入真实值；Bun 启动时自动加载
SB_DB_HOST=127.0.0.1
SB_DB_PORT=5432
SB_DB_USER=your_db_user
SB_DB_PASSWORD=your_db_password
SB_DB_NAME=sb
# Telegram 机器人 token（@BotFather 创建）与目标频道
SB_TELEGRAM_TOKEN=123456789:AAFE-xxxxxxx_your_bot_token
SB_TELEGRAM_CHAT_ID=@your_channel